pipeline {
    agent { label 'agent' }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        EKS_PUBLIC_KEY     = credentials('eks-public-key') // Jenkins secret
    }

    stages {

        stage('Checkout Code') {
            steps {
                git url: 'https://github.com/Vamsi987dev/expense-infra.git', branch: 'main'
            }
        }

        stage('Terraform Format') {
            steps {
                dir('4-eks') {
                    sh 'terraform fmt'
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir('4-eks') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('4-eks') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('4-eks') {
                    sh "terraform plan -var \"eks_public_key=${EKS_PUBLIC_KEY}\""
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('4-eks') {
                    sh "terraform apply -auto-approve -var \"eks_public_key=${EKS_PUBLIC_KEY}\""
                }
            }
        }

    }
}



